NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 공공데이터포털 일반 인증키 (Decoding)
MOLIT_API_KEY=
# 카카오 디벨로퍼스 앱의 REST API 키. 아파트명 후보 검색에 사용하며 서버에서만 읽습니다.
KAKAO_REST_API_KEY=
# 서버 전용: Supabase Settings > API Keys의 secret key. NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
SUPABASE_SECRET_KEY=
# Vercel Cron 요청 검증용 임의 문자열(16자 이상)
CRON_SECRET=
# 예약 수집 상태 판정 기준 시각(UTC ISO). 첫 운영 배포 시각을 입력합니다.
CRON_ENABLED_AT=
# 서버 전용: GitHub fine-grained token. 대상 저장소의 Issues 쓰기 권한만 부여합니다.
GITHUB_ISSUES_TOKEN=
# 선택 사항. 기본값은 gnlenfn/real_estate_price_tracker 입니다.
GITHUB_ISSUES_REPOSITORY=gnlenfn/real_estate_price_tracker
